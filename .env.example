# LLM (edge cases) - OpenRouter tem prioridade; ANTHROPIC_API_KEY é fallback
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# ANTHROPIC_API_KEY=sk-YOUR_KEY_HERE

# ServiceNow
SERVICENOW_INSTANCE=amamericas
SERVICENOW_TOKEN=YOUR_TOKEN_HERE
# true = "Aprovar" NÃO escreve no ServiceNow (só simula). Mude p/ false quando validado.
SERVICENOW_DRY_RUN=true

# App
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# Digifort (evidência de câmera): conta de serviço com direito só de live view
DIGIFORT_USER=
DIGIFORT_PASSWORD=
DIGIFORT_PORT=8601
